<?xml version="1.0" encoding="utf-8"?>
<!-- FrameLayout root: the help overlay must be part of this layout (not added to
     the wrap later) so the glasses cursor, added last by GlassesOut, stays on top -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="NeoXR"
                android:src="@drawable/logo_neoxr" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.03"
                    android:text="NeoXR"
                    android:textColor="@color/on_surface"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VR 180°/360° · SBS · for XR glasses"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="8sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnFile"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Open File"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnHelp"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="?"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- brand beam: the icon's gradient, running out from under the mark -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_beam_fade" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/siteInput"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Add a site or feed URL"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/on_surface_variant"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addSite"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="60dp"
                android:text="Add"
                android:textSize="10sp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:text="Tap to browse · long-press toggles the SBS menu"
            android:textColor="@color/on_surface_variant"
            android:textSize="8sp" />

        <ListView
            android:id="@+id/sites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="24dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- in-layout help: readable in every mode (plain / SBS split / on the glasses)
         — a dialog would be a separate window, invisible in stereo -->
    <FrameLayout
        android:id="@+id/helpOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/backdrop"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <TextView
                android:id="@+id/helpText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.35"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="48dp"
                android:textColor="@color/on_surface"
                android:textSize="10sp" />
        </ScrollView>

        <TextView
            android:id="@+id/helpClose"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- in-layout local video list: unlike the system picker (a phone-only window),
         this lives inside the wrap — visible on the glasses, SBS-aware, cursor-clickable -->
    <FrameLayout
        android:id="@+id/fileOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/backdrop"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:text="LOCAL VIDEOS"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/fileEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:text="No videos found on this device."
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:visibility="gone" />

            <ListView
                android:id="@+id/fileList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:paddingBottom="24dp"
                android:scrollbars="none" />
        </LinearLayout>

        <TextView
            android:id="@+id/fileClose"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />
    </FrameLayout>
</FrameLayout>
