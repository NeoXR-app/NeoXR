<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- two containers: landscape keeps everything in rowMain (single storey, the
         SBS overlay depends on that bar depth); portrait remote moves play/3D/
         quality into rowTop programmatically (applyRemoteDims) so the seek bar
         gets the full width below -->
    <LinearLayout
        android:id="@+id/controlsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_input"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

    <FrameLayout
        android:id="@+id/rowTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="2dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rowMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- U+25C4/U+25BA/U+2759: glyphs with no emoji variant — U+25B6/U+23F8 render
             as colored emoji on some vendor fonts and ignore textColor -->
        <TextView
            android:id="@+id/btnRw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:text="◄◄"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:text="►"
            android:textColor="@color/on_surface"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btnFf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:text="►►"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp" />

        <!-- monospace + fixed min width: proportional digits shift the buttons
             sideways on every tick, and they are already half-size in SBS copies -->
        <TextView
            android:id="@+id/timePos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minWidth="56dp"
            android:text="0:00"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressDrawable="@drawable/seekbar_track"
            android:splitTrack="false"
            android:thumb="@drawable/seekbar_thumb" />

        <TextView
            android:id="@+id/timeDur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minWidth="56dp"
            android:text="0:00"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn3d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:text="3D"
            android:textColor="@color/primary"
            android:textSize="14sp" />

        <!-- audio track / subtitle picker; hidden when a video has nothing to choose -->
        <TextView
            android:id="@+id/btnTracks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:text="CC"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:text="…"
            android:textColor="@color/primary"
            android:textSize="13sp" />
    </LinearLayout>
    </LinearLayout>

    <!-- stereo + geometry tuning: opened by the 3D button; buttons are huge on
         purpose — the whole overlay is drawn 2x squeezed for the glasses, small
         targets are unhittable. Two rows: convergence/eye-swap, then the vertical
         squeeze (the side columns have no height budget left for it) -->
    <LinearLayout
        android:id="@+id/eyePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="112dp"
        android:layout_marginEnd="112dp"
        android:layout_marginBottom="76dp"
        android:background="@drawable/bg_input"
        android:orientation="vertical"
        android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnEyeMinus"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/on_surface"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/txtEye"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="3D"
            android:textColor="@color/on_surface_variant"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnEyePlus"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/on_surface"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/btnEyeSwap"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="⇄"
            android:textColor="@color/on_surface"
            android:textSize="21sp" />
    </LinearLayout>

    <!-- width and height squeeze: in landscape the side columns have no height
         budget left, so both live here; portrait moves them into the right column -->
    <LinearLayout
        android:id="@+id/panelWidthRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnWMinus"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/on_surface"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/txtW"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1.4"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="W 100"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnWPlus"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/on_surface"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- stereo/mono output, phone playback only: without glasses a single view is
         what you want to look at -->
    <TextView
        android:id="@+id/btnMono"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:text="Output: stereo pair"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- ambient backdrop toggle: fills the black surround with the video's own
         colour, for flat and wide screens -->
    <TextView
        android:id="@+id/btnAmbient"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:text="Ambient glow: off"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/panelHeightRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnHMinus"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/on_surface"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/txtH"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1.4"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="H 100"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnHPlus"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/on_surface"
            android:textSize="24sp" />
    </LinearLayout>
    </LinearLayout>

    <!-- subtitles are drawn here, not by the player: the video goes to a GL texture,
         so ExoPlayer's own subtitle view would never reach the glasses. Sitting in
         the SBS overlay means each eye gets a copy. -->
    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitleText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="70dp"
        android:visibility="gone" />

    <!-- track menu: its own container (otherwise onTracksChanged rebuilding the
         quality list would overwrite it while open). Positioned in code right above
         its button and raised above everything else — see showPopup. Scrolls, since
         a file can carry more tracks than fit on screen. -->
    <ScrollView
        android:id="@+id/trackScroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_input"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/trackList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/qualityList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="112dp"
        android:layout_marginBottom="76dp"
        android:background="@drawable/bg_input"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone" />
</merge>
