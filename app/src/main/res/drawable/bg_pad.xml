<?xml version="1.0" encoding="utf-8"?>
<!-- the controller touchpad plate: a large calm surface, same radius family as
     the inputs but bigger — it reads as a physical trackpad, not a text field -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/surface" />
    <stroke android:width="1dp" android:color="@color/surface_stroke" />
    <corners android:radius="24dp" />
</shape>
