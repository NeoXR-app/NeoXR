<?xml version="1.0" encoding="utf-8"?>
<!-- selected browse row: filled panel with the beam pinned to its leading edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/beam_end"
                android:startColor="@color/beam_start" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:start="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_high" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
